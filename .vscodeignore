# =============================================================================
# .vscodeignore — what stays OUT of the published VSIX.
#
# Ships (do NOT add here): package.json, dist/extension.js,
# README.md, CHANGELOG.md, LICENSE, and the extension icon.
# Everything else is excluded. The bundle is built by esbuild, so no
# source, no intermediate output and no node_modules are needed at runtime.
# =============================================================================

# --- Source & intermediate build output (esbuild bundles src into dist) ------
src/**
out/**
**/*.ts
**/*.tsbuildinfo
**/*.map

# --- Tests -------------------------------------------------------------------
.vscode-test/**
.vscode-test.mjs
**/*.test.js

# --- Build & tooling config --------------------------------------------------
esbuild.js
tsconfig*.json
eslint.config.*
.eslintrc*
.eslintignore
biome.json
biome.jsonc
.prettierrc*
.editorconfig

# --- Editor / CI / repo metadata ---------------------------------------------
.vscode/**
.github/**
.devcontainer/**
.claude/**
.gitignore
.gitattributes
.git/**

# --- Package manager ---------------------------------------------------------
node_modules/**
package-lock.json
yarn.lock
pnpm-lock.yaml
.npmrc
.yarnrc*

# --- Internal docs (not shown on the Marketplace) ----------------------------
vsc-extension-quickstart.md

# --- Build outputs of this very command --------------------------------------
*.vsix

# --- Secrets: never publishable ----------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.ovpn
.ovsx-token
.vsce-token
*.token
secrets.json

# --- OS / editor noise -------------------------------------------------------
.DS_Store
Thumbs.db
*.log
